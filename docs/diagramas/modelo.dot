digraph Aduana { graph [rankdir=LR,bgcolor="#f7f8f4",pad="0.5",nodesep="0.4",ranksep="1.2",label="INVENTARIO ADUANERO · Modelo físico PostgreSQL\nPK/FK · NN = NOT NULL · 1 a 0..N · Sin borrados en cascada",labelloc=t,fontsize=24,fontname="Arial"]; node[shape=plain,fontname="Arial"];edge[color="#789780",fontname="Arial",fontsize=9];
